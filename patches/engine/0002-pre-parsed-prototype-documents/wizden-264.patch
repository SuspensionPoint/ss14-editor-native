+using System;
+using System.Collections.Generic;
+using System.IO;
+using Robust.Shared.Serialization.Markdown;
+using Robust.Shared.Utility;
+
+namespace Robust.Shared.Prototypes;
+
+// Editor kernel patch: pre-parsed prototype documents.
+//
+// Parsing every prototype file from YAML text is the slowest part of starting the engine in a
+// browser. This hook lets a host hand LoadDirectory the documents for a file already parsed
+// (the same DataNode trees the YAML parser would produce, built ahead of time on a desktop
+// machine). When the hook is unset, or returns null for a file, nothing changes.
+public partial class PrototypeManager
+{
+    /// <summary>
+    /// Returns the already-parsed documents for a prototype file, or null to parse its text.
+    /// </summary>
+    public static Func<ResPath, IEnumerable<DataNodeDocument>?>? PreParsedDocuments;
+
+    private static IEnumerable<DataNodeDocument> ParsePrototypeDocuments(ResPath file, TextReader reader)
+    {
+        return PreParsedDocuments?.Invoke(file) ?? DataNodeParser.ParseYamlStream(reader);
+    }
+}
