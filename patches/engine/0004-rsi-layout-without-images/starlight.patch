+        /// <summary>
+        /// When set, an RSI folder is laid out from its meta.json alone: its images are not read
+        /// and its sheet is left blank. For hosts that track what is drawn but never draw.
+        /// </summary>
+        public static bool LayoutOnly;
+
+        private static void LoadPreTextureLayoutOnly(RsiLoading.RsiMetadata metadata, ref LoadStepData data)
+        {
+            data.FrameCounts = RsiLoading.CalculateFrameCounts(metadata);
+
+            // The same layout as RsiLoading.GenerateAtlas.
+            var total = 0;
+            foreach (var count in data.FrameCounts)
+                total += count;
+            total = Math.Max(1, total);
+            var dimensionX = (int) MathF.Ceiling(MathF.Sqrt(total));
+            var dimensionY = (int) MathF.Ceiling((float) total / dimensionX);
+
+            data.AtlasSheet = new Image<Rgba32>(dimensionX * metadata.Size.X, dimensionY * metadata.Size.Y);
+            data.DimX = dimensionX;
+
+            LoadPreTextureCommon(metadata, ref data);
+
+            data.LoadParameters = metadata.LoadParameters;
+            data.MetaAtlas = metadata.MetaAtlas;
+        }
